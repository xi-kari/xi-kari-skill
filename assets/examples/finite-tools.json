          "s2": "g1",
          "s3": "g2"
        }
      }
    },
    "schedule-shared-capacity": {
      "schema_version": 1,
      "title": "单项各自可行，共享时段联合无解",
      "fictional": true,
      "assumptions": [
        "每格是一个相同长度的教学时间单位。",
        "任务连续、不可抢占、需求固定，资格/授权/材料标记均是假设已就绪。"
      ],
      "boundaries": [
        "只判断给定时段和明示约束。",
        "有排程不证明人工复核质量或实际干预成功。"
      ],
      "operator": "resource_schedule",
      "input": {
