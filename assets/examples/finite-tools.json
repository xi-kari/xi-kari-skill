    "condition-complement": {
      "schema_version": 1,
      "title": "只有两条件同时改变才合格",
      "fictional": true,
      "assumptions": [
        "合格表在给定菜单内完整；不在表中即不合格。",
        "变化效果为教学指定，不来自经验估计。"
      ],
      "boundaries": [
        "包含极小不等于最少个数或最低成本。",
        "工具不能放松固定条件或证明干预现实有效。"
      ],
      "operator": "condition_search",
      "input": {
        "variables": [
          {
            "id": "x",
            "current": 0,
            "values": [
              0,
              1
            ],
            "mutable": true
          },
          {
            "id": "y",
            "current": 0,
            "values": [
              0,
              1
            ],
