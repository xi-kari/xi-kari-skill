    "relation-local-without-chain": {
      "schema_version": 1,
      "title": "各段关系存在，整链缺共同中间对象",
      "fictional": true,
      "assumptions": [
        "关系为明示有限二元关系；中间层对象的ID决定是否同一个对象。"
      ],
      "boundaries": [
        "有限反例只证明局部存在不足以推出整链共同见证。",
        "不否定独立获得的总效应，不认定现实机制就是本例。"
      ],
      "operator": "relation_chain",
      "input": {
        "layers": [
          {
            "id": "start",
            "members": [
              "a"
            ]
          },
          {
            "id": "middle",
            "members": [
              "b1",
              "b2"
