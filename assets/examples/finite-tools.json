      "schema_version": 1,
      "title": "四状态任务划分：1",
      "fictional": true,
      "assumptions": [
        "所有列出的动作对全部状态确定且全定义。",
        "任务回答、转移关系均为教学设定。"
      ],
      "boundaries": [
        "有限期限充分不自动等于动力闭合。",
        "动作串长度不是现实经过时间。"
      ],
      "operator": "task_partition",
      "input": {
        "states": [
          "a",
          "b",
          "c",
          "d"
