    "common-action-triple": {
      "schema_version": 1,
      "title": "两两相交而三者无共同动作",
      "fictional": true,
      "assumptions": [
        "兼容状态、动作资格、确定性观察分组均由调用者给定。"
      ],
      "boundaries": [
        "不生成概率价值、最优动作或现实授权。"
      ],
      "operator": "common_actions",
      "input": {
