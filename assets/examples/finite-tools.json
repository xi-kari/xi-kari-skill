    "representation-two-errors": {
      "schema_version": 1,
      "title": "表示损失与规则错误并存",
      "fictional": true,
      "assumptions": [
        "只比较三个明示状态。"
      ],
      "boundaries": [
        "最坏绝对误差界采用可取任意实数的解码器。",
        "不检测真实记录当时是否可达。"
      ],
      "operator": "representation_audit",
      "input": {
        "representation": {
          "s0": "0",
          "s1": "0",
          "s2": "1"
        },
        "query": {
          "s0": 0,
          "s1": 1,
          "s2": 1
        },
        "actual_decoder": {
          "0": 0,
          "1": 0
        }
      }
