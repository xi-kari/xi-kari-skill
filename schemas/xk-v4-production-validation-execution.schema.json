{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v4.validation-execution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "boundary", "parent_pid", "launcher_pid", "child_pid", "command", "command_sha256", "exit_status", "provider_environment_sha256", "stdout_sha256", "stderr_sha256", "report_sha256", "completed_at"],
  "properties": {
    "schema_id": {"const": "xi-kari.v4.validation-execution"},
    "schema_version": {"const": 4},
    "run_id": {"type": ["string", "null"]},
    "boundary": {"enum": ["preseal", "promotion", "official", "final"]},
    "parent_pid": {"type": "integer", "minimum": 1},
    "launcher_pid": {"type": "integer", "minimum": 1},
    "child_pid": {"type": "integer", "minimum": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "command_sha256": {"$ref": "#/$defs/sha256"},
    "exit_status": {"type": "integer"},
    "provider_environment_sha256": {"$ref": "#/$defs/sha256"},
    "stdout_sha256": {"$ref": "#/$defs/sha256"},
    "stderr_sha256": {"$ref": "#/$defs/sha256"},
    "report_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
