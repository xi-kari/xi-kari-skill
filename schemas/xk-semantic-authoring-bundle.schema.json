{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v3.semantic-authoring-bundle.schema.json",
  "title": "Xi-Kari v3 runtime-owned semantic authoring bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "input_packet_sha256",
    "source_lock_sha256",
    "read_plan_sha256",
    "adapter_binding_sha256",
    "authorings"
  ],
  "properties": {
    "schema_id": {
      "const": "xi-kari.v3.semantic-probe-authorings"
    },
    "schema_version": {
      "const": 3
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "read_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "adapter_binding_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/authoring"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_id",
        "variant_kind",
        "generation_context_id",
        "requested_stance",
        "time_window",
        "problem_contract_sha256",
        "evidence_context_sha256",
        "semantic_packet_sha256",
        "runtime_receipt",
        "runtime_receipt_sha256",
        "semantic_packet"
      ],
      "properties": {
        "authoring_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_kind": {
          "enum": [
            "stance-support",
            "stance-oppose",
            "time-window-shift"
          ]
        },
        "generation_context_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_stance": {
          "enum": [
            "support",
            "oppose"
          ]
        },
        "time_window": {
          "type": "string",
          "minLength": 1
        },
        "problem_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_receipt": {
          "$ref": "#/$defs/receipt"
        },
        "runtime_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_packet": {
          "type": "object"
        }
      }
    },
    "receipt": {
      "$ref": "#/$defs/receipt_v3"
    },
    "receipt_v3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "adapter_executable_sha256",
        "adapter_argv_sha256",
        "variant_kind",
        "requested_stance",
        "time_window",
        "generation_context_id",
        "input_sha256",
        "input_byte_count",
        "stdout_sha256",
        "stdout_byte_count",
        "stderr_sha256",
        "child_pid",
        "parent_pid",
        "exit_status",
        "semantic_packet_sha256",
        "semantic_request_sha256",
        "semantic_request_byte_count",
        "outer_input_sha256",
        "outer_input_byte_count",
        "provider_binding_sha256",
        "provider_executable_sha256",
        "provider_argv_sha256",
        "provider_execution"
      ],
      "properties": {
        "protocol": {
          "const": "xi-kari.v3.semantic-authoring-receipt/v3"
        },
        "adapter_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adapter_argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variant_kind": {
          "enum": [
            "stance-support",
            "stance-oppose",
            "time-window-shift"
          ]
        },
        "requested_stance": {
          "enum": [
            "support",
            "oppose"
          ]
        },
        "time_window": {
          "type": "string",
          "minLength": 1
        },
        "generation_context_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262143
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stdout_byte_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 67108864
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "child_pid": {
          "type": "integer",
          "minimum": 1
        },
        "parent_pid": {
          "type": "integer",
          "minimum": 1
        },
        "exit_status": {
          "const": 0
        },
        "semantic_packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_request_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262143
        },
        "outer_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "outer_input_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262143
        },
        "provider_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_execution": {
          "$ref": "#/$defs/providerExecution"
        }
      }
    },
    "providerExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "provider_parent_pid",
        "provider_child_pid",
        "exit_status",
        "thread_id",
        "events",
        "events_sha256",
        "semantic_file_content",
        "semantic_file_sha256",
        "semantic_file_byte_count"
      ],
      "properties": {
        "protocol": {
          "const": "xi-kari.v3.semantic-file-output/v1"
        },
        "provider_parent_pid": {
          "type": "integer",
          "minimum": 1
        },
        "provider_child_pid": {
          "type": "integer",
          "minimum": 1
        },
        "exit_status": {
          "const": 0
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "string",
          "minLength": 1
        },
        "events_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_file_content": {
          "type": "string",
          "minLength": 2
        },
        "semantic_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_file_byte_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16777216
        }
      }
    }
  }
}
