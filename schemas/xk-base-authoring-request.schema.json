{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.base-authoring-request.schema.json",
  "title": "Xi-Kari v2 runtime base authoring request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "protocol", "run_id", "mode", "problem_contract", "privacy_contract", "source_inputs"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.base-authoring-request"},
    "schema_version": {"const": 1},
    "protocol": {"const": "xi-kari.v2.base-authoring/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["open-world", "closed-input"]},
    "problem_contract": {"type": "object"},
    "privacy_contract": {"$ref": "#/$defs/privacyContract"},
    "natural_request": {
      "$ref": "https://xi-kari.local/schemas/xi-kari.v2.natural-request.schema.json"
    },
    "source_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_version", "repository_root", "reader_root", "source_manifest_path", "source_lock", "read_plan", "concept_authority", "ontology_root", "ontology_read_plan", "base_provider_binding"],
      "properties": {
        "source_version": {"const": "v8.2"},
        "repository_root": {"type": "string", "minLength": 1},
        "reader_root": {"type": "string", "minLength": 1},
        "source_manifest_path": {"type": "string", "minLength": 1},
        "source_lock": {"type": "object"},
        "read_plan": {"type": "object"},
        "concept_authority": {"type": "object"},
        "ontology_root": {"type": "string", "minLength": 1},
        "ontology_read_plan": {"$ref": "#/$defs/ontologyReadPlanBinding"},
        "base_provider_binding": {"type": "object"},
        "closed_input_materials": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/material"}
        },
        "frozen_material_manifest": {"$ref": "#/$defs/materialManifest"}
      },
      "allOf": [
        {
          "if": {"required": ["closed_input_materials"]},
          "then": {"required": ["frozen_material_manifest"]}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "closed-input"}}, "required": ["mode"]},
      "then": {
        "properties": {
          "source_inputs": {"required": ["closed_input_materials", "frozen_material_manifest"]}
        }
      },
      "else": {
        "properties": {
          "source_inputs": {
            "not": {
              "anyOf": [
                {"required": ["closed_input_materials"]},
                {"required": ["frozen_material_manifest"]}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "privacyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "delivery_audience", "classification_scheme", "fail_closed"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "delivery_audience": {"type": "string", "minLength": 1},
        "classification_scheme": {
          "const": ["public", "context_limited", "sensitive", "highly_sensitive", "refused_disclosure"]
        },
        "fail_closed": {"const": true}
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "origin", "title", "content", "content_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "origin": {"const": "user_material"},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "published_at": {"type": "string", "minLength": 1},
        "event_at": {"type": "string", "minLength": 1}
      }
    },
    "materialManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials", "manifest_sha256"],
      "properties": {
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "content_sha256"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "content_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ontologyReadPlanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "schema_version", "run_id", "problem_contract_sha256",
        "content_access_challenge", "proof_kind", "witness_protocol", "authority_bindings",
        "candidate_count", "card_count", "required_neighbor_count",
        "continuity_bundle_count", "record_count", "complete", "plan_sha256",
        "item_id_protocol"
      ],
      "properties": {
        "schema_id": {"const": "xi-kari.v2.ontology-read-plan-binding"},
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "problem_contract_sha256": {"$ref": "#/$defs/sha256"},
        "content_access_challenge": {"$ref": "#/$defs/sha256"},
        "proof_kind": {"const": "byte-access+problem-bound-semantic-trace"},
        "witness_protocol": {"const": "xi-kari.v2.ontology-content-witness/v1"},
        "authority_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_census_sha256", "concept_registry_sha256",
            "concept_relations_sha256", "continuity_bundle_registry_sha256"
          ],
          "properties": {
            "candidate_census_sha256": {"$ref": "#/$defs/sha256"},
            "concept_registry_sha256": {"$ref": "#/$defs/sha256"},
            "concept_relations_sha256": {"$ref": "#/$defs/sha256"},
            "continuity_bundle_registry_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "candidate_count": {"type": "integer", "minimum": 1},
        "card_count": {"type": "integer", "minimum": 1},
        "required_neighbor_count": {"type": "integer", "minimum": 1},
        "continuity_bundle_count": {"type": "integer", "minimum": 1},
        "record_count": {"type": "integer", "minimum": 1},
        "complete": {"const": true},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "item_id_protocol": {"type": "string", "minLength": 1}
      }
    }
  }
}
