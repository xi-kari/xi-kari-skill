{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.case-ledger.schema.json",
  "title": "Xi-Kari v2 case and countercase ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "cases", "countercases"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.case-ledger"},
    "schema_version": {"const": 3},
    "run_id": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "kind", "summary", "tests_claim_ids", "source_refs", "conditions", "stop_conditions", "cannot_prove"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["documented_real_case", "user_material_case", "conditional_scenario", "structural_analogy"]},
          "summary": {"type": "string", "minLength": 1},
          "tests_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "cannot_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "conditional_scenario"}}, "required": ["kind"]},
            "then": {
              "properties": {
                "conditions": {"minItems": 1},
                "stop_conditions": {"minItems": 1}
              }
            }
          }
        ]
      }
    },
    "countercases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["countercase_id", "attacks_claim_ids", "attacks_mechanism_ids", "conditions", "expected_signal", "reverse_signal", "decision_impact", "source_refs"],
        "properties": {
          "countercase_id": {"type": "string", "minLength": 1},
          "attacks_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "attacks_mechanism_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expected_signal": {"type": "string", "minLength": 1},
          "reverse_signal": {"type": "string", "minLength": 1},
          "decision_impact": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
