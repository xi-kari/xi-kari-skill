{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.ontology-read-trace.schema.json",
  "title": "Xi-Kari v2 bound ontology read trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "run_id", "problem_contract_sha256",
    "content_access_challenge", "proof_kind", "witness_protocol",
    "ontology_read_plan_sha256",
    "semantic_trace_input_sha256", "record_count", "records", "complete"
  ],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.ontology-read-trace"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "problem_contract_sha256": {"$ref": "#/$defs/sha256"},
    "content_access_challenge": {"$ref": "#/$defs/sha256"},
    "proof_kind": {"const": "byte-access+problem-bound-semantic-trace"},
    "witness_protocol": {"const": "xi-kari.v2.ontology-content-witness/v1"},
    "ontology_read_plan_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_trace_input_sha256": {"$ref": "#/$defs/sha256"},
    "record_count": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/traceRecord"}
    },
    "complete": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "traceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "kind", "subject_id", "related_subject_id", "path",
        "content_sha256", "disposition", "read_status", "content_witness",
        "content_excerpt", "problem_relation"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/nonempty"},
        "kind": {
          "enum": [
            "candidate", "canonical_or_structural_card",
            "required_neighbor", "continuity_bundle"
          ]
        },
        "subject_id": {"$ref": "#/$defs/nonempty"},
        "related_subject_id": {
          "oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]
        },
        "path": {"$ref": "#/$defs/nonempty"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {"$ref": "#/$defs/nonempty"},
        "read_status": {"const": "read"},
        "content_witness": {"$ref": "#/$defs/sha256"},
        "content_excerpt": {"type": "string", "minLength": 12},
        "problem_relation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "rationale"],
          "properties": {
            "status": {"enum": ["applied", "boundary_only", "not_applicable"]},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
