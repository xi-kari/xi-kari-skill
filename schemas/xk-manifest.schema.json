{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.artifact-manifest.schema.json",
  "title": "Xi-Kari v2 artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "runtime_version", "artifact_schema_version", "run_id", "input_packet_sha256", "candidate_census_sha256", "validated_chain_head_sha256", "validator_set_sha256", "phase_responsibilities", "phase_artifacts", "delivery", "continuation_bindings"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.artifact-manifest"},
    "schema_version": {"const": 3},
    "runtime_version": {"type": "string", "pattern": "^2\\."},
    "artifact_schema_version": {"const": 3},
    "run_id": {"type": "string", "minLength": 1},
    "input_packet_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_census_sha256": {"$ref": "#/$defs/sha256"},
    "validated_chain_head_sha256": {"$ref": "#/$defs/sha256"},
    "validator_set_sha256": {"$ref": "#/$defs/sha256"},
    "phase_responsibilities": {"type": "object", "minProperties": 13, "maxProperties": 13, "additionalProperties": {"type": "string"}},
    "phase_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/phaseBinding"}
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "dossier", "atlas", "casebook", "artifact_index", "final_chat"],
      "properties": {
        "answer": {"$ref": "#/$defs/binding"},
        "dossier": {"$ref": "#/$defs/binding"},
        "atlas": {"$ref": "#/$defs/binding"},
        "casebook": {"$ref": "#/$defs/binding"},
        "artifact_index": {"$ref": "#/$defs/binding"},
        "final_chat": {"$ref": "#/$defs/binding"}
      }
    },
    "continuation_bindings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^delivery/[^/]+\\.(?:md|json)$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "phaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "phase", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"},
        "phase": {"enum": ["XK0", "XK1", "XK2", "XK3", "XK4", "XK5", "XK6", "XK7", "XK8", "XK9", "XK10", "XK11"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
