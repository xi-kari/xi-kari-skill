{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.retrieval.schema.json",
  "title": "Xi-Kari v2 retrieval ledger or index",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "run_id", "mode", "status"],
      "properties": {
        "schema_id": {"const": "xi-kari.v2.retrieval-ledger"},
        "schema_version": {"const": 3},
        "run_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["open-world", "closed-input"]},
        "status": {"const": "awaiting_retrieval"}
      }
    },
    {
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "run_id", "mode", "queries", "saturation_status", "remaining_unknowns", "sources", "assessments", "input_packet_sha256", "source_count", "all_sources_assessed"],
      "properties": {
        "schema_id": {"const": "xi-kari.v2.retrieval-ledger"},
        "schema_version": {"const": 3},
        "run_id": {"type": "string"},
        "mode": {"enum": ["open-world", "closed-input"]},
        "queries": {"type": "array", "items": {"$ref": "#/$defs/query"}},
        "saturation_status": {"enum": ["bounded_saturation", "evidence_saturated", "authority_exhausted", "capability_limited", "source_internal_only"]},
        "remaining_unknowns": {"type": "array", "items": {"type": "string"}},
        "directional_evidence": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/directional_evidence"}
        },
        "capability_gap": {"type": ["string", "null"]},
        "frozen_material_manifest": {"$ref": "#/$defs/materialManifest"},
        "sources": {"type": "array", "items": {"type": "object"}},
        "assessments": {"type": "array", "items": {"type": "object"}},
        "input_packet_sha256": {"$ref": "#/$defs/sha256"},
        "source_count": {"type": "integer", "minimum": 0},
        "all_sources_assessed": {"const": true},
        "execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "host_event_stream_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "closed-input"}}, "required": ["mode"]},
          "then": {"required": ["frozen_material_manifest"]},
          "else": {"not": {"required": ["frozen_material_manifest"]}}
        },
        {
          "if": {"properties": {"saturation_status": {"const": "evidence_saturated"}}, "required": ["saturation_status"]},
          "then": {"required": ["directional_evidence"]}
        }
      ]
    },
    {
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "mode", "run_id", "sources", "source_count", "all_sources_assessed"],
      "properties": {
        "schema_id": {"const": "xi-kari.v2.retrieval-index"},
        "schema_version": {"const": 3},
        "mode": {"enum": ["open-world", "closed-input"]},
        "run_id": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "source_count": {"type": "integer", "minimum": 0},
        "all_sources_assessed": {"const": true}
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials", "manifest_sha256"],
      "properties": {
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "content_sha256"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "content_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_path", "source_sha256", "assessment_path", "assessment_sha256", "assessment_verdict", "origin", "content_sha256", "content_authority", "independence_key", "independence_identity"],
      "properties": {
        "source_id": {"type": "string"},
        "source_path": {"type": "string", "pattern": "^retrieval/sources/"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "assessment_path": {"type": "string", "pattern": "^retrieval/assessments/"},
        "assessment_sha256": {"$ref": "#/$defs/sha256"},
        "assessment_verdict": {"enum": ["admitted", "usable_with_limits", "rejected", "nonprobative"]},
        "origin": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "content_authority": {"enum": ["model-authored-excerpt", "host-observed", "unknown"]},
        "host_observation": {"$ref": "#/$defs/host_observation"},
        "independence_key": {"$ref": "#/$defs/sha256"},
        "independence_identity": {"type": "string", "minLength": 1}
      }
    },
    "host_observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "event_stream_sha256", "open_event_ids"],
          "properties": {
            "status": {"const": "unbound"},
            "event_stream_sha256": {"$ref": "#/$defs/sha256"},
            "open_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "binding_sha256", "event_stream_sha256", "open_event_ids"],
          "properties": {
            "status": {"const": "bound"},
            "binding_sha256": {"$ref": "#/$defs/sha256"},
            "event_stream_sha256": {"$ref": "#/$defs/sha256"},
            "open_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "binding_sha256", "event_stream_sha256", "open_event_ids", "capture_id", "requested_url", "final_url", "peer_ip", "response_status", "content_type", "charset", "body_sha256", "text_sha256", "body_byte_count", "text_character_count", "redirect_chain", "excerpt_sha256", "excerpt_start", "excerpt_end"],
          "properties": {
            "status": {"const": "bound"},
            "binding_sha256": {"$ref": "#/$defs/sha256"},
            "event_stream_sha256": {"$ref": "#/$defs/sha256"},
            "open_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "capture_id": {"type": "string", "minLength": 1},
            "requested_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "final_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "peer_ip": {"type": ["string", "null"]},
            "response_status": {"type": "integer", "minimum": 200, "maximum": 299},
            "content_type": {"type": "string", "minLength": 1},
            "charset": {"type": "string", "minLength": 1},
            "body_sha256": {"$ref": "#/$defs/sha256"},
            "text_sha256": {"$ref": "#/$defs/sha256"},
            "body_byte_count": {"type": "integer", "minimum": 1},
            "text_character_count": {"type": "integer", "minimum": 1},
            "redirect_chain": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
            "excerpt_sha256": {"$ref": "#/$defs/sha256"},
            "excerpt_start": {"type": "integer", "minimum": 0},
            "excerpt_end": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "direction", "query", "status", "executed_at", "result_source_ids"],
      "properties": {
        "query_id": {"type": "string", "pattern": "^QUERY-[A-Z0-9_-]+$"},
        "direction": {"enum": ["current_baseline", "mechanism_support", "counterevidence", "comparable_case", "affected_low_power_position", "authoritative_definition"]},
        "query": {"type": "string", "minLength": 1},
        "status": {"enum": ["executed", "saturated", "capability_limited", "not_applicable"]},
        "executed_at": {"type": ["string", "null"], "format": "date-time"},
        "stop_reason": {"type": ["string", "null"]},
        "result_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["saturated", "capability_limited", "not_applicable"]}}, "required": ["status"]},
          "then": {"required": ["stop_reason"], "properties": {"stop_reason": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "directional_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "search_event_id", "stop_boundary", "source_urls", "source_ids", "distinct_url_count", "distinct_source_count", "distinct_content_count", "distinct_independence_count", "new_information_count", "stop_reason"],
      "properties": {
        "direction": {"enum": ["current_baseline", "mechanism_support", "counterevidence", "comparable_case", "affected_low_power_position"]},
        "search_event_id": {"type": "string", "minLength": 1},
        "stop_boundary": {"type": "string", "minLength": 1},
        "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "distinct_url_count": {"type": "integer", "minimum": 1},
        "distinct_source_count": {"type": "integer", "minimum": 1},
        "distinct_content_count": {"type": "integer", "minimum": 1},
        "distinct_independence_count": {"type": "integer", "minimum": 1},
        "new_information_count": {"type": "integer", "minimum": 0},
        "stop_reason": {"enum": ["next_direction_search", "turn_completed"]}
      }
    }
  }
}
