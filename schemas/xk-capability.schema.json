{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v3.capability-snapshot.schema.json",
  "title": "Xi-Kari v3 capability snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "mode",
    "network_retrieval",
    "full_source_read_required",
    "source_unit_count",
    "reader_unit_count",
    "semantic_authoring_adapter",
    "captured_at",
    "contract_profile"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "contract_profile"
        ],
        "properties": {
          "contract_profile": {
            "const": "production-authoring-v3"
          }
        }
      },
      "then": {
        "required": [
          "execute_owned_binding"
        ],
        "properties": {
          "semantic_authoring_adapter": {
            "type": "object",
            "required": [
              "protocol",
              "profile"
            ],
            "properties": {
              "protocol": {
                "const": "xi-kari.v3.semantic-authoring-adapter/v3"
              },
              "profile": {
                "const": "production-codex"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_id": {
      "const": "xi-kari.v3.capability-snapshot"
    },
    "schema_version": {
      "const": 3
    },
    "run_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "open-world",
        "closed-input"
      ]
    },
    "contract_profile": {
      "const": "production-authoring-v3"
    },
    "network_retrieval": {
      "type": "boolean"
    },
    "full_source_read_required": {
      "const": true
    },
    "source_unit_count": {
      "const": 4753
    },
    "reader_unit_count": {
      "const": 21
    },
    "execute_owned_binding": {
      "$ref": "#/$defs/execute_owned_binding"
    },
    "semantic_authoring_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "argv",
        "argv_sha256",
        "executable_path",
        "executable_sha256",
        "timeout_seconds",
        "profile",
        "provider_binding",
        "provider_binding_sha256"
      ],
      "properties": {
        "protocol": {
          "const": "xi-kari.v3.semantic-authoring-adapter/v3"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "argv_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "executable_path": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "profile": {
          "const": "production-codex"
        },
        "provider_binding": {
          "$ref": "#/$defs/codex_provider_binding"
        },
        "provider_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "execute_owned_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "owner",
        "run_id",
        "parent_pid",
        "child_pid",
        "exit_status",
        "provider_binding_sha256",
        "provider_executable_sha256",
        "provider_argv_sha256",
        "adapter_executable_sha256",
        "command_sha256",
        "input_sha256",
        "prompt_sha256",
        "stdout_sha256",
        "stderr_sha256",
        "semantic_output_sha256",
        "semantic_read_trace_sha256",
        "ontology_read_plan_sha256",
        "ontology_read_trace_sha256",
        "base_receipt_sha256",
        "retrieval_receipt_sha256",
        "retrieval_sha256"
      ],
      "properties": {
        "protocol": {
          "const": "xi-kari.v3.execute-owned-binding/v1"
        },
        "owner": {
          "const": "execute_authored_run"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_pid": {
          "type": "integer",
          "minimum": 1
        },
        "child_pid": {
          "type": "integer",
          "minimum": 1
        },
        "exit_status": {
          "const": 0
        },
        "provider_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adapter_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_read_trace_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ontology_read_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ontology_read_trace_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retrieval_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retrieval_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "codex_provider_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "repository_root",
        "executable_path",
        "executable_sha256",
        "argv",
        "argv_sha256",
        "model",
        "reasoning_effort",
        "approval_policy",
        "sandbox",
        "ephemeral",
        "ignore_user_config",
        "strict_config",
        "web_search",
        "timeout_seconds"
      ],
      "properties": {
        "protocol": {
          "const": "xi-kari.v3.codex-provider-binding/v1"
        },
        "repository_root": {
          "type": "string",
          "minLength": 1
        },
        "executable_path": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "argv": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "argv_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": "string"
        },
        "approval_policy": {
          "const": "never"
        },
        "sandbox": {
          "const": "workspace-write"
        },
        "ephemeral": {
          "const": true
        },
        "ignore_user_config": {
          "const": true
        },
        "strict_config": {
          "type": "boolean"
        },
        "web_search": {
          "enum": [
            "live",
            "disabled"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        }
      }
    }
  }
}
