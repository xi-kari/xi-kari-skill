{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.run-status.schema.json",
  "title": "Xi-Kari v2 derived run status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "run_dir", "mode", "state", "phase_count", "current_phase", "next_phase", "chain_head_sha256", "generation", "parent_run_id"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.run-status"},
    "schema_version": {"const": 3},
    "run_id": {"type": ["string", "null"]},
    "run_dir": {"type": "string", "minLength": 1},
    "mode": {"enum": ["open-world", "closed-input"]},
    "state": {"enum": ["initialized", "prepared", "in_progress", "needs_attention", "complete", "cancelled", "invalid"]},
    "phase_count": {"type": "integer", "minimum": 0, "maximum": 13},
    "current_phase": {"type": ["string", "null"], "pattern": "^XK(?:[0-9]|1[0-2])$"},
    "next_phase": {"type": ["string", "null"], "pattern": "^XK(?:[0-9]|1[0-2])$"},
    "chain_head_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "generation": {"type": "integer", "minimum": 0},
    "parent_run_id": {"type": ["string", "null"]},
    "attention_errors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity_errors": {"type": "array", "items": {"type": "string"}}
  }
}
