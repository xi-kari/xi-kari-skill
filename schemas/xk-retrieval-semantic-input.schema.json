{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.retrieval-semantic-input.schema.json",
  "title": "Xi-Kari v2 model retrieval before runtime projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "mode", "queries", "sources", "assessments", "saturation_status", "capability_gap", "remaining_unknowns"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.retrieval-semantic-input"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["open-world", "closed-input"]},
    "queries": {"type": "array"},
    "sources": {"type": "array"},
    "assessments": {"type": "array"},
    "saturation_status": {"type": "string", "minLength": 1},
    "capability_gap": {"type": "string", "minLength": 1},
    "remaining_unknowns": {"type": "array", "items": {"type": "string"}},
    "frozen_material_manifest": {"$ref": "#/$defs/materialManifest"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "closed-input"}}, "required": ["mode"]},
      "then": {"required": ["frozen_material_manifest"]},
      "else": {"not": {"required": ["frozen_material_manifest"]}}
    }
  ],
  "$defs": {
    "materialManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials", "manifest_sha256"],
      "properties": {
        "materials": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "content_sha256"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
