{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.forecast-ledger.schema.json",
  "title": "Xi-Kari v2 forecast ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.forecast-ledger"},
    "schema_version": {"const": 3},
    "run_id": {"type": "string"},
    "target": {"type": "string"},
    "deadline": {"type": "string"},
    "baseline": {"type": "string"},
    "conditional_paths": {"type": "array"},
    "early_signals": {"type": "array"},
    "reverse_signals": {"type": "array"},
    "numeric_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "calibration_basis": {
      "oneOf": [
        {"$ref": "#/$defs/calibrationBasis"},
        {"type": "null"}
      ]
    },
    "dynamic_applicability": {"enum": ["applicable", "not_applicable"]},
    "status": {"type": "string"}
  },
  "oneOf": [
    {"required": ["target", "deadline", "baseline", "conditional_paths", "early_signals", "reverse_signals", "numeric_probability"]},
    {
      "required": ["dynamic_applicability", "status"],
      "properties": {
        "dynamic_applicability": {"const": "not_applicable"},
        "status": {"const": "not_run"}
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {"numeric_probability": {"type": "number"}},
        "required": ["numeric_probability"]
      },
      "then": {"required": ["calibration_basis"]}
    }
  ],
  "$defs": {
    "calibrationBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "method", "reference_class", "measurement", "unit", "generation_method", "sample_size", "positive_outcomes", "observed_frequency", "source_refs"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "method": {"const": "empirical-frequency"},
        "reference_class": {"type": "string", "minLength": 1},
        "measurement": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "generation_method": {"type": "string", "minLength": 1},
        "sample_size": {"type": "integer", "minimum": 1},
        "positive_outcomes": {"type": "integer", "minimum": 0},
        "observed_frequency": {"type": "number", "minimum": 0, "maximum": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
