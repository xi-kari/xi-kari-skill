{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.semantic-read-trace-input.schema.json",
  "title": "Xi-Kari v2 model semantic read trace input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "records"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.semantic-read-trace-input"},
    "schema_version": {"const": 1},
    "records": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reader_unit", "synthesis", "semantic_observations", "continuity_with_previous", "problem_relation", "source_undefined_refs"],
      "properties": {
        "reader_unit": {"type": "string", "minLength": 1},
        "synthesis": {"type": "string", "minLength": 1},
        "semantic_observations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/observation"}
        },
        "continuity_with_previous": {"$ref": "#/$defs/continuity"},
        "problem_relation": {"$ref": "#/$defs/problem_relation"},
        "source_undefined_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposition", "role", "source_anchor_refs"],
      "properties": {
        "proposition": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "source_anchor_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V82-(?:P[0-9]{4}|T[0-9]{3})$"}
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_reader_unit", "relation", "explanation"],
      "properties": {
        "previous_reader_unit": {"type": ["string", "null"]},
        "relation": {"enum": ["root", "extends", "qualifies", "limits", "instantiates"]},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "problem_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {"enum": ["applied", "boundary_only", "not_applicable"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
