{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.base-authoring-execution.schema.json",
  "title": "Xi-Kari v2 runtime-owned base authoring receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "protocol", "run_id",
    "provider_binding_sha256", "provider_executable_sha256", "provider_argv_sha256",
    "adapter_executable_sha256", "command_sha256", "parent_pid", "child_pid",
    "started_at", "completed_at", "exit_status", "thread_id", "input_sha256",
    "input_byte_count", "prompt_sha256", "prompt_byte_count", "stdout_sha256", "stdout_byte_count", "stderr_sha256",
    "stderr_byte_count", "semantic_output_sha256", "semantic_output_byte_count",
    "semantic_read_trace_sha256", "semantic_read_trace_byte_count", "ontology_read_plan_sha256", "ontology_problem_contract_sha256", "ontology_content_access_challenge_sha256", "ontology_proof_kind", "ontology_read_trace_sha256", "ontology_read_trace_byte_count", "events_path", "request_path", "prompt_path", "output_path",
    "receipt_sha256"
  ],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.base-authoring-execution"},
    "schema_version": {"const": 1},
    "protocol": {"const": "xi-kari.v2.base-authoring/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "provider_binding_sha256": {"$ref": "#/$defs/sha256"},
    "provider_executable_sha256": {"$ref": "#/$defs/sha256"},
    "provider_argv_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_executable_sha256": {"$ref": "#/$defs/sha256"},
    "command_sha256": {"$ref": "#/$defs/sha256"},
    "parent_pid": {"type": "integer", "minimum": 1},
    "child_pid": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "exit_status": {"const": 0},
    "thread_id": {"type": "string", "minLength": 1},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "input_byte_count": {"type": "integer", "minimum": 1},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_byte_count": {"type": "integer", "minimum": 1},
    "stdout_sha256": {"$ref": "#/$defs/sha256"},
    "stdout_byte_count": {"type": "integer", "minimum": 1},
    "stderr_sha256": {"$ref": "#/$defs/sha256"},
    "stderr_byte_count": {"type": "integer", "minimum": 0},
    "semantic_output_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_output_byte_count": {"type": "integer", "minimum": 1},
    "semantic_read_trace_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_read_trace_byte_count": {"type": "integer", "minimum": 1},
    "ontology_read_plan_sha256": {"$ref": "#/$defs/sha256"},
    "ontology_problem_contract_sha256": {"$ref": "#/$defs/sha256"},
    "ontology_content_access_challenge_sha256": {"$ref": "#/$defs/sha256"},
    "ontology_proof_kind": {"const": "byte-access+problem-bound-semantic-trace"},
    "ontology_read_trace_sha256": {"$ref": "#/$defs/sha256"},
    "ontology_read_trace_byte_count": {"type": "integer", "minimum": 1},
    "events_path": {"const": "authoring/XK01-base-authoring-events.jsonl"},
    "request_path": {"const": "authoring/XK01-base-authoring-request.json"},
    "prompt_path": {"const": "authoring/XK01-base-authoring-prompt.txt"},
    "output_path": {"const": "authoring/XK01-base-authoring-output.bin"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
