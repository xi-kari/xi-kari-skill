{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.phase-event.schema.json",
  "title": "Xi-Kari v2 phase event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "phase", "index", "predecessor_sha256", "input_sha256", "artifact_bindings", "created_at", "record_sha256"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.phase-event"},
    "schema_version": {"const": 3},
    "run_id": {"type": "string"},
    "phase": {"type": "string", "pattern": "^XK(?:[0-9]|1[0-2])$"},
    "index": {"type": "integer", "minimum": 0, "maximum": 12},
    "predecessor_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "created_at": {"type": "string", "format": "date-time"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
