{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.repair.schema.json",
  "title": "Xi-Kari v2 repair plan or record",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
        "required": ["schema_id", "schema_version", "run_id", "earliest_invalid_phase", "reset_phases", "reason", "fresh", "validator_fresh_process", "validator_fingerprint_sha256"],
      "properties": {
        "schema_id": {"const": "xi-kari.v2.repair-plan"},
        "schema_version": {"const": 3},
        "run_id": {"$ref": "#/$defs/runId"},
        "earliest_invalid_phase": {"$ref": "#/$defs/phase"},
        "reset_phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
        "reason": {"type": "array", "items": {"type": "string"}},
        "fresh": {"const": true},
        "validator_fresh_process": {"const": true},
        "validator_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "planned_state": {"const": "invalid"},
        "run_contract_sha256": {"$ref": "#/$defs/sha256"},
        "phase_events_sha256": {"$ref": "#/$defs/sha256"},
        "run_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "validator_set_sha256": {"$ref": "#/$defs/sha256"},
        "validation_errors_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    {
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "run_id", "parent_run_id", "earliest_invalid_phase", "reason", "replacement_packet_sha256", "parent_repair_plan_sha256", "parent_repair_reset_phases"],
      "properties": {
        "schema_id": {"const": "xi-kari.v2.repair-record"},
        "schema_version": {"const": 3},
        "run_id": {"$ref": "#/$defs/runId"},
        "parent_run_id": {"$ref": "#/$defs/runId"},
        "earliest_invalid_phase": {"$ref": "#/$defs/phase"},
        "reason": {"type": "string", "minLength": 1},
        "replacement_packet_sha256": {"$ref": "#/$defs/sha256"},
        "parent_repair_plan_sha256": {"$ref": "#/$defs/sha256"},
        "parent_repair_reset_phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}}
      }
    }
  ],
  "$defs": {
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "phase": {"type": "string", "pattern": "^XK(?:[0-9]|1[0-2])$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
