{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/source-manifest-v90.schema.json",
  "title": "Xi-Kari v9.0 source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "framework_version",
    "framework_revision",
    "raw_sha256",
    "semantic_sha256",
    "semantic_normalization_version",
    "list_structure_sha256",
    "list_structure_normalization_version",
    "xml_sha256",
    "structural_flags",
    "body_block_count",
    "paragraph_count",
    "nonempty_paragraph_count",
    "empty_paragraph_count",
    "top_level_paragraph_count",
    "list_paragraph_count",
    "list_format_counts",
    "heading_count",
    "table_count",
    "non_whitespace_chars",
    "source_unit_count",
    "source_unit_sequence",
    "source_unit_file_sha256",
    "index_file_sha256",
    "alias_index_sha256",
    "candidate_ruleset_version",
    "candidate_count",
    "candidate_count_semantics",
    "candidate_kind_counts",
    "candidate_index_sha256",
    "domain_entry_count",
    "coordinate_contract",
    "divisions",
    "reader_unit_count",
    "reader_units",
    "sequence",
    "reader_file_sha256",
    "reader_files",
    "audit_files",
    "index_files"
  ],
  "properties": {
    "schema_id": {"const": "xi-kari.v9.0.source-manifest"},
    "schema_version": {"const": 3},
    "framework_version": {"const": "v9.0"},
    "framework_revision": {"const": "local-delivery-2026-09-30"},
    "raw_sha256": {
      "const": "ffc45afdc288ecd268fd02e46d47318b7ddf17bf7b47605aa6c413c95398544b"
    },
    "semantic_sha256": {
      "const": "24bf22bad46be7369df5c3a99976b48561ca03ac7f85500b4dbd7819a92015ac"
    },
    "semantic_normalization_version": {"const": 2},
    "list_structure_sha256": {
      "const": "0517e112d6c2d02c254eb42f8d139d293dff57e56ab53c5a7551e1f92f020de9"
    },
    "list_structure_normalization_version": {"const": 2},
    "xml_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word/document.xml", "word/numbering.xml", "word/styles.xml"],
      "properties": {
        "word/document.xml": {"$ref": "#/$defs/sha256"},
        "word/numbering.xml": {"$ref": "#/$defs/sha256"},
        "word/styles.xml": {"$ref": "#/$defs/sha256"}
      }
    },
    "structural_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked_insertions",
        "tracked_deletions",
        "drawings",
        "textboxes",
        "math_objects"
      ],
      "properties": {
        "tracked_insertions": {"const": 0},
        "tracked_deletions": {"const": 0},
        "drawings": {"const": 0},
        "textboxes": {"const": 0},
        "math_objects": {"const": 0}
      }
    },
    "body_block_count": {"const": 1952},
    "paragraph_count": {"const": 4298},
    "nonempty_paragraph_count": {"const": 4175},
    "empty_paragraph_count": {"const": 123},
    "top_level_paragraph_count": {"const": 1832},
    "list_paragraph_count": {"const": 162},
    "list_format_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bullet", "decimal"],
      "properties": {
        "bullet": {"const": 139},
        "decimal": {"const": 23}
      }
    },
    "heading_count": {"type": "integer", "minimum": 1},
    "table_count": {"const": 120},
    "non_whitespace_chars": {"const": 204514},
    "source_unit_count": {"const": 4418},
    "source_unit_sequence": {
      "type": "array",
      "minItems": 4418,
      "maxItems": 4418,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^V90-(?:P\\d{5}|T\\d{3})$"}
    },
    "source_unit_file_sha256": {"$ref": "#/$defs/hash_map"},
    "index_file_sha256": {"$ref": "#/$defs/hash_map"},
    "alias_index_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_ruleset_version": {"const": 5},
    "candidate_count": {"const": 3105},
    "candidate_count_semantics": {"type": "string", "minLength": 1},
    "candidate_kind_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "domain_entry",
        "definition",
        "table",
        "variable",
        "operator",
        "constraint",
        "undefined_field"
      ],
      "properties": {
        "heading": {"type": "integer", "minimum": 0},
        "domain_entry": {"const": 32},
        "definition": {"type": "integer", "minimum": 0},
        "table": {"type": "integer", "minimum": 0},
        "variable": {"type": "integer", "minimum": 0},
        "operator": {"type": "integer", "minimum": 0},
        "constraint": {"type": "integer", "minimum": 0},
        "undefined_field": {"type": "integer", "minimum": 0}
      }
    },
    "candidate_index_sha256": {"$ref": "#/$defs/sha256"},
    "domain_entry_count": {"const": 32},
    "coordinate_contract": {"type": "string", "minLength": 1},
    "divisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/division"}
    },
    "reader_unit_count": {"type": "integer", "minimum": 1},
    "reader_units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:00-source-envelope|\\d{2,})\\.md$"}
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:00-source-envelope|\\d{2,})\\.md$"}
    },
    "reader_file_sha256": {"$ref": "#/$defs/hash_map"},
    "reader_files": {"$ref": "#/$defs/path_list"},
    "audit_files": {"$ref": "#/$defs/path_list"},
    "index_files": {"$ref": "#/$defs/path_list"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "path_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "division": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "title",
        "reader_file",
        "body_anchors",
        "paragraph_anchors",
        "table_anchors",
        "source_unit_anchors"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "reader_file": {"type": "string", "pattern": "^(?:00-source-envelope|\\d{2,})\\.md$"},
        "body_anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V90-B\\d{5}$"}
        },
        "paragraph_anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V90-P\\d{5}$"}
        },
        "table_anchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V90-T\\d{3}$"}
        },
        "source_unit_anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V90-(?:P\\d{5}|T\\d{3})$"}
        }
      }
    }
  }
}
