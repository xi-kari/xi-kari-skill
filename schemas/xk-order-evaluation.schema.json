{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v3.order-evaluation.schema.json",
  "title": "Xi-Kari v3 recursive order evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id"],
  "properties": {
    "schema_id": {"const": "xi-kari.v3.order-evaluation"},
    "schema_version": {"const": 3},
    "run_id": {"type": "string"},
    "orders": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "evaluated_node_ids", "evaluated_branch_ids", "not_run_branch_ids", "baseline", "baseline_binding", "explanatory_increment", "explanatory_increment_binding", "predictive_increment", "predictive_increment_binding", "new_assumptions", "new_losses", "local_predictability", "continue_value"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 3},
          "evaluated_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evaluated_branch_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "not_run_branch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "baseline": {"type": "string", "minLength": 1},
          "baseline_binding": {"$ref": "#/$defs/evaluationBinding"},
          "explanatory_increment": {"type": "string", "minLength": 1},
          "explanatory_increment_binding": {"$ref": "#/$defs/evaluationBinding"},
          "predictive_increment": {"type": "string", "minLength": 1},
          "predictive_increment_binding": {"$ref": "#/$defs/evaluationBinding"},
          "new_assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "new_losses": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "local_predictability": {"type": "string", "minLength": 1},
          "continue_value": {"type": "string", "minLength": 1}
        }
      }
    },
    "dynamic_applicability": {"enum": ["applicable", "not_applicable"]},
    "status": {"type": "string"}
  },
  "oneOf": [
    {"required": ["orders"]},
    {
      "required": ["dynamic_applicability", "status"],
      "properties": {
        "dynamic_applicability": {"const": "not_applicable"},
        "status": {"const": "not_run"}
      }
    }
  ],
  "$defs": {
    "evaluationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated_node_ids", "evaluated_branch_ids", "content_sha256", "delta_sha256"],
      "properties": {
        "evaluated_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evaluated_branch_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "delta_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
