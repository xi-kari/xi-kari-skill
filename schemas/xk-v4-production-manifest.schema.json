{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "xi-kari.v4.artifact-manifest"
    },
    "schema_version": {
      "const": 4
    },
    "runtime_version": {
      "const": "4.0.0"
    },
    "artifact_schema_version": {
      "const": 4
    },
    "source_version": {
      "const": "v9.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_census_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validated_chain_head_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validator_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase_responsibilities": {
      "type": "object"
    },
    "phase_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "path": {
                    "pattern": "^(?:authoring/XK01-base-authoring-stderr\\.bin|(?:sem|semantic-executions)/attempt-[0-9a-f]{32}/capture/stderr\\.bin)$"
                  }
                }
              },
              "else": {
                "properties": {
                  "bytes": {"minimum": 1}
                }
              }
            }
          ]
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "dossier",
        "atlas",
        "casebook",
        "artifact_index",
        "final_chat"
      ],
      "properties": {
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "dossier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "atlas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "casebook": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "artifact_index": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "final_chat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "runtime_version",
    "artifact_schema_version",
    "source_version",
    "run_id",
    "input_packet_sha256",
    "candidate_census_sha256",
    "validated_chain_head_sha256",
    "validator_set_sha256",
    "phase_responsibilities",
    "phase_artifacts",
    "delivery"
  ],
  "$id": "https://xi-kari.local/schemas/xi-kari.v4.artifact-manifest.schema.json",
  "title": "Xi-Kari v4 artifact-manifest"
}
