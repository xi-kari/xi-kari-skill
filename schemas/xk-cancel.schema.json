{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.cancel.schema.json",
  "title": "Xi-Kari v2 run cancellation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "reason", "cancelled_at"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.cancel"},
    "schema_version": {"const": 3},
    "run_id": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "cancelled_at": {"type": "string", "format": "date-time"}
  }
}
