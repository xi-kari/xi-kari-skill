{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v3.reader-sections.schema.json",
  "title": "Xi-Kari complete authored reader sections",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["section_id", "heading", "local_judgment", "paragraphs", "source_bindings"],
    "properties": {
      "section_id": {"type": "string", "minLength": 1},
      "heading": {"type": "string", "minLength": 1},
      "local_judgment": {"type": "string", "minLength": 1},
      "paragraphs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "source_bindings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_path", "paragraph_index", "excerpt"],
          "properties": {
            "source_path": {"type": "string", "minLength": 1},
            "paragraph_index": {"type": "integer", "minimum": 0, "description": "0 denotes local_judgment; 1 through N denote paragraphs[0] through paragraphs[N-1]."},
            "excerpt": {"type": "string", "minLength": 1, "description": "A real excerpt of the indexed paragraph that retains the substantive source value; a link, marker or summary cannot stand in for the argument."}
          }
        }
      }
    }
  }
}
