{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/concept-registry-v90.schema.json",
  "title": "Xi-Kari v9.0 generated concept registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "framework_version",
    "source_raw_sha256",
    "identity_register_sha256",
    "extended_identity_register_sha256",
    "concept_count",
    "concept_count_semantics",
    "candidate_count",
    "candidate_count_semantics",
    "unresolved_candidate_count",
    "candidate_disposition_counts",
    "candidate_census_sha256",
    "neighbor_policy",
    "concepts"
  ],
  "properties": {
    "schema_id": {"const": "xi-kari.concept-registry"},
    "schema_version": {"const": 2},
    "framework_version": {"const": "v9.0"},
    "source_raw_sha256": {
      "const": "ffc45afdc288ecd268fd02e46d47318b7ddf17bf7b47605aa6c413c95398544b"
    },
    "identity_register_sha256": {"$ref": "#/$defs/sha256"},
    "extended_identity_register_sha256": {"$ref": "#/$defs/sha256"},
    "concept_count": {"type": "integer", "minimum": 93},
    "concept_count_semantics": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 1},
    "candidate_count_semantics": {"type": "string", "minLength": 1},
    "unresolved_candidate_count": {"const": 0},
    "candidate_disposition_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "alias", "subordinate_value", "out_of_scope"],
      "properties": {
        "canonical": {"type": "integer", "minimum": 1},
        "alias": {"type": "integer", "minimum": 0},
        "subordinate_value": {"type": "integer", "minimum": 0},
        "out_of_scope": {"type": "integer", "minimum": 0}
      }
    },
    "candidate_census_sha256": {"$ref": "#/$defs/sha256"},
    "neighbor_policy": {
      "const": "typed dependency graph; only inferential_requires is projected into required_neighbors"
    },
    "concepts": {
      "type": "array",
      "minItems": 93,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "source_concept_id",
          "disposition",
          "inventory_path",
          "card_path",
          "source_anchors",
          "required_neighbors",
          "hashes",
          "validation"
        ],
        "properties": {
          "concept_id": {"type": "string", "pattern": "^V90-CANON-[A-Z0-9-]+$"},
          "source_concept_id": {"type": "string", "minLength": 1},
          "disposition": {"const": "canonical_concept"},
          "inventory_path": {"type": "string", "minLength": 1},
          "card_path": {"type": "string", "pattern": "^references/ontology/v9\\.0/cards/"},
          "source_anchors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^V90-P\\d{5}$"}
          },
          "required_neighbors": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^V90-CANON-[A-Z0-9-]+$"}
          },
          "hashes": {"type": "object", "minProperties": 3},
          "validation": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
