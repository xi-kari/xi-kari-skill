{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.runtime.temporal-audit-context.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "problem_contract_sha256", "evidence_scope", "origin_run_directory", "origin_run_path_sha256", "audit_sha256", "members"],
  "properties": {
    "schema_id": {"const": "xi-kari.runtime.temporal-audit-context"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "problem_contract_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_scope": {"const": "isolated_runtime_reads"},
    "origin_run_directory": {"type": "string", "minLength": 1},
    "origin_run_path_sha256": {"$ref": "#/$defs/sha256"},
    "audit_sha256": {"$ref": "#/$defs/sha256"},
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_path", "snapshot_path", "sha256", "bytes"],
        "properties": {
          "source_path": {"type": "string", "minLength": 1},
          "snapshot_path": {"type": "string", "pattern": "^temporal-evidence/source/.+"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
