{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.closed-input-materials.schema.json",
  "title": "Xi-Kari v2 closed-input material envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "materials"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.closed-input-materials"},
    "schema_version": {"const": 1},
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "content"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "title": {"type": "string", "minLength": 1, "maxLength": 16384},
          "content": {"type": "string", "minLength": 1, "maxLength": 16777216},
          "published_at": {"type": "string", "minLength": 1},
          "event_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
