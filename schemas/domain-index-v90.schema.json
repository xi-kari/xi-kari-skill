{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/domain-index-v90.schema.json",
  "title": "Xi-Kari v9.0 domain identity index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "framework_version",
    "source_raw_sha256",
    "entry_count",
    "entry_count_semantics",
    "entries"
  ],
  "properties": {
    "schema_id": {"const": "xi-kari.v9.0.domain-index"},
    "schema_version": {"const": 1},
    "framework_version": {"const": "v9.0"},
    "source_raw_sha256": {
      "const": "ffc45afdc288ecd268fd02e46d47318b7ddf17bf7b47605aa6c413c95398544b"
    },
    "entry_count": {"const": 32},
    "entry_count_semantics": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "identity_id",
        "title",
        "source_refs",
        "source_anchors",
        "candidate_ids",
        "primary_candidate_id",
        "content_owner",
        "index_and_consumer_owner",
        "contract",
        "required_runtime_evidence",
        "source_fingerprint_sha256",
        "content_status",
        "content_path",
        "content_sha256",
        "read_trace_status"
      ],
      "properties": {
        "domain_id": {"type": "string", "pattern": "^D\\.(?:0[1-9]|[12]\\d|3[0-2])$"},
        "identity_id": {"type": "string", "pattern": "^V90-DOMAIN-D(?:0[1-9]|[12]\\d|3[0-2])$"},
        "title": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1},
        "source_anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V90-P\\d{5}$"}
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V90-CANDIDATE-"}
        },
        "primary_candidate_id": {"type": "string", "pattern": "^V90-CANDIDATE-P\\d{5}$"},
        "content_owner": {"type": "string", "pattern": "^P11[A-H]$"},
        "index_and_consumer_owner": {"const": "sole_engineering_integrator"},
        "contract": {"type": "string", "minLength": 1},
        "required_runtime_evidence": {"type": "array", "minItems": 1, "uniqueItems": true},
        "source_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_status": {"const": "identity_only"},
        "content_path": {"type": "null"},
        "content_sha256": {"type": "null"},
        "read_trace_status": {"const": "not_yet_available"}
      }
    }
  }
}
