{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/source-manifest.schema.json",
  "title": "Xi-Kari v8.2 source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "framework_version",
    "framework_revision",
    "raw_sha256",
    "semantic_sha256",
    "semantic_normalization_version",
    "list_structure_sha256",
    "list_structure_normalization_version",
    "paragraph_count",
    "list_paragraph_count",
    "heading_count",
    "table_count",
    "concept_count",
    "concept_count_semantics",
    "candidate_ruleset_version",
    "candidate_count",
    "candidate_count_semantics",
    "candidate_kind_counts",
    "candidate_index_sha256",
    "contract_count",
    "source_unit_count",
    "source_unit_sequence",
    "source_unit_file_sha256",
    "non_whitespace_chars",
    "divisions",
    "reader_units",
    "reader_unit_count",
    "sequence",
    "reader_file_sha256",
    "reader_files",
    "audit_files",
    "index_files"
  ],
  "properties": {
    "schema_id": {"const": "xi-kari.v8.2.source-manifest"},
    "schema_version": {"const": 2},
    "framework_version": {"const": "v8.2"},
    "framework_revision": {"const": "v8.2"},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_normalization_version": {"type": "integer", "const": 1},
    "list_structure_sha256": {"const": "8b4a40f8559ac61c1bb8c224054de7978bb93298efbbd41f40ed065f89bab050"},
    "list_structure_normalization_version": {"type": "integer", "const": 1},
    "paragraph_count": {"type": "integer", "const": 4631},
    "list_paragraph_count": {"type": "integer", "const": 162},
    "heading_count": {"type": "integer", "const": 344},
    "table_count": {"type": "integer", "const": 122},
    "concept_count": {"type": "integer", "const": 349},
    "concept_count_semantics": {"const": "mechanical count of distinct (style, text) pairs among concept-styled source paragraphs; not a complete ontology concept count"},
    "candidate_ruleset_version": {"type": "integer", "const": 4},
    "candidate_count": {"type": "integer", "minimum": 1},
    "candidate_count_semantics": {"const": "deterministic source-signal census under the declared ruleset; not an ontology classification or a complete or fixed concept count"},
    "candidate_kind_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "definition", "table", "variable", "operator", "constraint", "undefined_field"],
      "properties": {
        "heading": {"type": "integer", "minimum": 1},
        "definition": {"type": "integer", "minimum": 1},
        "table": {"type": "integer", "minimum": 1},
        "variable": {"type": "integer", "minimum": 1},
        "operator": {"type": "integer", "minimum": 1},
        "constraint": {"type": "integer", "minimum": 1},
        "undefined_field": {"type": "integer", "minimum": 0}
      }
    },
    "candidate_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_count": {"type": "integer", "const": 8},
    "source_unit_count": {"type": "integer", "const": 4753},
    "source_unit_sequence": {
      "type": "array",
      "minItems": 4753,
      "maxItems": 4753,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^V82-(P[0-9]{4}|T[0-9]{3})$"}
    },
    "source_unit_file_sha256": {
      "type": "object",
      "minProperties": 124,
      "propertyNames": {
        "pattern": "^(audit/paragraphs\\.jsonl|audit/tables/V82-T[0-9]{3}\\.md|indexes/tables\\.json)$"
      },
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "non_whitespace_chars": {"type": "integer", "const": 165690},
    "divisions": {"type": "array", "minItems": 20},
    "reader_units": {"type": "array", "minItems": 21},
    "reader_unit_count": {"type": "integer", "const": 21},
    "sequence": {"type": "array", "minItems": 21},
    "reader_file_sha256": {"type": "object", "minProperties": 21, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "reader_files": {"type": "array", "minItems": 22},
    "audit_files": {"type": "array", "minItems": 123},
    "index_files": {"type": "array", "minItems": 5}
  }
}
