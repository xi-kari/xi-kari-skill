{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.xk.recursive-lineage.schema.json",
  "x-namespace": "xi-kari.v2.xk",
  "title": "Xi-Kari v2 recursive lineage and four branches",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "source_version", "ontology_refs", "source_anchors", "world_volume_id", "nodes", "branches", "not_run_orders", "maximum_order"],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.xk.recursive-lineage"},
    "source_version": {"const": "v8.2"},
    "ontology_refs": {"$ref": "#/$defs/ontologyRefs"},
    "source_anchors": {"$ref": "#/$defs/sourceAnchors"},
    "world_volume_id": {"$ref": "#/$defs/id"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branch"}},
    "not_run_orders": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/notRunOrder"}},
    "maximum_order": {"type": "integer", "minimum": 1, "maximum": 3}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9_.:-]*$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nonempty": {"type": "string", "minLength": 1},
    "ontologyRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^V82-(?:CANON|CANDIDATE|HEADING)-[A-Z0-9-]+$"}},
    "sourceAnchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^V82-(?:P[0-9]{4}|T[0-9]{3})$"}},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "path_id", "parent_node_ids", "order", "state_id"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "path_id": {"$ref": "#/$defs/id"},
        "parent_node_ids": {"$ref": "#/$defs/ids"},
        "order": {"type": "integer", "minimum": 1, "maximum": 3},
        "state_id": {"$ref": "#/$defs/id"}
      },
      "allOf": [
        {
          "if": {"properties": {"order": {"const": 1}}, "required": ["order"]},
          "then": {"properties": {"parent_node_ids": {"maxItems": 0}}},
          "else": {"properties": {"parent_node_ids": {"minItems": 1}}}
        }
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "kind", "explanation_id", "node_ids", "status", "merge_parent_branch_ids", "prune_reason", "retained_residual_ids", "stop_reason"],
      "properties": {
        "branch_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["main", "strongest-rival", "mixture", "residual"]},
        "explanation_id": {"$ref": "#/$defs/id"},
        "node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "status": {"enum": ["active", "merged", "pruned", "stopped"]},
        "merge_parent_branch_ids": {"$ref": "#/$defs/ids"},
        "prune_reason": {"oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
        "retained_residual_ids": {"$ref": "#/$defs/ids"},
        "stop_reason": {"oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]}
      }
    },
    "notRunOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "order", "blocked_by_node_id", "reason"],
      "properties": {
        "branch_id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 2, "maximum": 3},
        "blocked_by_node_id": {"$ref": "#/$defs/id"},
        "reason": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}
