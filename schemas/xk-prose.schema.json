{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v3.prose-plan.schema.json",
  "title": "Xi-Kari v3 prose plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "formats", "deliverable_type", "delivery_mode", "reader_sections", "reader_beats", "direct_answer", "coverage", "jargon_dump_forbidden", "input_packet_sha256"],
  "properties": {
    "schema_id": {"const": "xi-kari.v3.prose-plan"},
    "schema_version": {"const": 3},
    "run_id": {"type": "string", "minLength": 1},
    "formats": {"type": "array", "const": ["answer", "dossier", "atlas", "casebook"]},
    "deliverable_type": {"enum": ["analysis", "decision", "charter", "plan", "critique"]},
    "delivery_mode": {"const": "full"},
    "reader_sections": {"$ref": "https://xi-kari.local/schemas/xi-kari.v3.reader-sections.schema.json"},
    "reader_beats": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "direct_answer": {"type": "string", "minLength": 1},
    "coverage": {"type": "object"},
    "jargon_dump_forbidden": {"const": true},
    "input_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
