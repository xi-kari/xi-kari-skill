{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/three-order-inference.schema.json",
  "title": "Xi-Kari one-to-three-order inference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question", "applicability", "baseline", "orders", "paths", "stop_conditions"],
  "properties": {
    "schema_version": { "type": "string", "const": "xk-three-order-inference-1" },
    "question": { "type": "string", "minLength": 1 },
    "applicability": { "type": "string", "enum": ["applicable", "not_applicable", "conditional", "undecided"] },
    "non_applicability_reason": { "type": "string" },
    "baseline": { "type": "string", "minLength": 1 },
    "orders": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/order" },
      "prefixItems": [
        { "properties": { "order": { "const": 1 } } },
        { "properties": { "order": { "const": 2 } } },
        { "properties": { "order": { "const": 3 } } }
      ]
    },
    "paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "unresolved": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "applicability": { "const": "applicable" } } },
      "then": { "properties": { "orders": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "applicability": { "const": "not_applicable" } } },
      "then": {
        "required": ["non_applicability_reason"],
        "properties": { "orders": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": {
          "orders": {
            "contains": {
              "type": "object",
              "required": ["order", "status"],
              "properties": {
                "order": { "const": 2 },
                "status": { "enum": ["stopped", "not_supported", "not_applicable"] }
              }
            }
          }
        }
      },
      "then": { "properties": { "orders": { "maxItems": 2 } } }
    },
    {
      "if": {
        "properties": {
          "orders": {
            "contains": {
              "type": "object",
              "required": ["order"],
              "properties": { "order": { "const": 3 } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "orders": {
            "minItems": 3,
            "prefixItems": [
              { "properties": { "order": { "const": 1 } } },
              {
                "required": ["status"],
                "properties": {
                  "order": { "const": 2 },
                  "status": { "enum": ["supported", "conditional"] }
                }
              },
              { "properties": { "order": { "const": 3 } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "status", "nodes", "transition_guard"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "status": { "type": "string", "enum": ["supported", "conditional", "stopped", "not_supported", "not_applicable"] },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/order_node" } },
        "transition_guard": { "type": "string", "minLength": 1 },
        "failure_reason": { "type": "string" }
      }
    },
    "order_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_state",
        "state_delta",
        "carrier",
        "scale_or_circle",
        "clock",
        "conditions",
        "evidence",
        "countermechanism",
        "failure_condition",
        "early_signal"
      ],
      "properties": {
        "input_state": { "type": "string", "minLength": 1 },
        "state_delta": { "type": "string", "minLength": 1 },
        "carrier": { "type": "string", "minLength": 1 },
        "scale_or_circle": { "type": "string", "minLength": 1 },
        "clock": { "type": "string", "minLength": 1 },
        "conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "countermechanism": { "type": "string", "minLength": 1 },
        "failure_condition": { "type": "string", "minLength": 1 },
        "early_signal": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reverse_signal": { "type": "array", "items": { "type": "string" } },
        "writeback": { "type": "string" }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mechanism_ref", "condition", "terminal_or_stop"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mechanism_ref": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "terminal_or_stop": { "type": "string", "minLength": 1 },
        "orders_present": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 3 } }
      }
    }
  }
}
