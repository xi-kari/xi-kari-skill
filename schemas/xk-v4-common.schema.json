{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v4.xk.common.schema.json",
  "title": "Xi-Kari v4 semantic responsibility fields",
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_state",
        "transformation",
        "mechanism",
        "recursion",
        "forecast",
        "action_choice"
      ],
      "properties": {
        "world_state": {
          "$ref": "#/$defs/stageApplicability"
        },
        "transformation": {
          "$ref": "#/$defs/stageApplicability"
        },
        "mechanism": {
          "$ref": "#/$defs/stageApplicability"
        },
        "recursion": {
          "$ref": "#/$defs/stageApplicability"
        },
        "forecast": {
          "$ref": "#/$defs/stageApplicability"
        },
        "action_choice": {
          "$ref": "#/$defs/stageApplicability"
        }
      }
    },
    "stageApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale",
        "source_refs",
        "dependency_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "applicable",
            "not_applicable",
            "undetermined"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependency_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "claimBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope",
        "material_refs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source_fact",
            "domain_empirical",
            "text_interpretation",
            "formal_proof",
            "normative_argument",
            "formal_framework_instance"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object",
            "population",
            "window",
            "target"
          ],
          "properties": {
            "object": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "population": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "window": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "end": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "material_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      }
    },
    "formalQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "family",
        "concept_ref",
        "instance_refs",
        "status",
        "result_status",
        "reason"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "family": {
          "enum": [
            "G",
            "H",
            "C",
            "CM",
            "not_applicable"
          ]
        },
        "concept_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "status": {
          "enum": [
            "not_requested",
            "not_evaluated",
            "qualified",
            "unqualified",
            "undetermined"
          ]
        },
        "result_status": {
          "enum": [
            "supported",
            "null_supported",
            "unsupported_or_undecided",
            "not_evaluated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "evidenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "canonical_locator",
        "content_sha256",
        "lineage_refs"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "canonical_locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lineage_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      }
    },
    "supportCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_refs",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "undetermined",
            "not_checked",
            "not_applicable"
          ]
        },
        "basis_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "supportChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_exists",
        "quotation_accurate",
        "passage_supports_claim",
        "world_fact_supported"
      ],
      "properties": {
        "source_exists": {
          "$ref": "#/$defs/supportCheck"
        },
        "quotation_accurate": {
          "$ref": "#/$defs/supportCheck"
        },
        "passage_supports_claim": {
          "$ref": "#/$defs/supportCheck"
        },
        "world_fact_supported": {
          "$ref": "#/$defs/supportCheck"
        }
      }
    },
    "researchContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_design",
        "read_extent",
        "provenance_refs",
        "independence_key"
      ],
      "properties": {
        "research_design": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "read_extent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provenance_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "independence_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "protectedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "minimal_scope",
        "review_at",
        "trusted_verifier_ref"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "minimal_scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "review_at": {
          "type": "string",
          "format": "date-time"
        },
        "trusted_verifier_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_id",
        "to_ref",
        "role",
        "source_refs",
        "condition",
        "scope"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "from_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "to_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "claim",
                "concept",
                "protocol",
                "instance"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "role": {
          "enum": [
            "inferential_requires",
            "protocol_requires",
            "specializes",
            "applies_to"
          ]
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "route_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "inputRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "from_id",
        "input_ref",
        "status",
        "source_refs",
        "condition",
        "scope"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "from_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "input_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "undetermined",
            "not_applicable",
            "withheld_for_protection"
          ]
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "route_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "rivalAssessment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "rivals"
          ],
          "properties": {
            "status": {
              "const": "identified"
            },
            "rivals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim_refs",
                  "target",
                  "rationale",
                  "material_refs",
                  "failure_conditions"
                ],
                "properties": {
                  "claim_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1
                  },
                  "target": {
                    "enum": [
                      "effect_size",
                      "mechanism",
                      "meaning",
                      "extrapolation",
                      "normative_premise"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "material_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1
                  },
                  "failure_conditions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "search_scope",
            "failure_conditions"
          ],
          "properties": {
            "status": {
              "enum": [
                "no_reasonable_rival",
                "undetermined"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "search_scope": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "failure_conditions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
