{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v3.retrieval-plan.schema.json",
  "title": "Xi-Kari v3 retrieval plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "mode", "open_world_default", "network_allowed", "external_definition_authority", "source_assessment_policy"],
  "properties": {
    "schema_id": {"const": "xi-kari.v3.retrieval-plan"},
    "schema_version": {"const": 3},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["open-world", "closed-input"]},
    "open_world_default": {"type": "boolean"},
    "network_allowed": {"type": "boolean"},
    "external_definition_authority": {"const": false},
    "source_assessment_policy": {"const": "one-separate-assessment-per-source"}
  }
}
