{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v2.stability.schema.json",
  "title": "Xi-Kari v2 fresh semantic stance stability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "input_packet_sha256",
    "neutrality_key",
    "runs",
    "invariant_projection_sha256",
    "stable"
  ],
  "properties": {
    "schema_id": {"const": "xi-kari.v2.stance-stability-report"},
    "schema_version": {"const": 3},
    "run_id": {"type": "string", "minLength": 1},
    "input_packet_sha256": {"$ref": "#/$defs/sha256"},
    "neutrality_key": {"$ref": "#/$defs/sha256"},
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/run"}
    },
    "invariant_projection_sha256": {"$ref": "#/$defs/sha256"},
    "stable": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_stance",
        "authoring_id",
        "authoring_provenance_sha256",
        "process_pid",
        "input_variant_sha256",
        "invariant_projection_sha256",
        "downstream_projection_sha256",
        "verdict_sha256",
        "action_ranking_sha256",
        "valid",
        "errors"
      ],
      "properties": {
        "requested_stance": {"enum": ["support", "oppose"]},
        "authoring_id": {"type": "string", "minLength": 1},
        "authoring_provenance_sha256": {"$ref": "#/$defs/sha256"},
        "process_pid": {"type": "integer", "minimum": 1},
        "input_variant_sha256": {"$ref": "#/$defs/sha256"},
        "invariant_projection_sha256": {"$ref": "#/$defs/sha256"},
        "downstream_projection_sha256": {"$ref": "#/$defs/sha256"},
        "verdict_sha256": {"$ref": "#/$defs/sha256"},
        "action_ranking_sha256": {"$ref": "#/$defs/sha256"},
        "valid": {"const": true},
        "errors": {"type": "array", "maxItems": 0}
      }
    }
  }
}
