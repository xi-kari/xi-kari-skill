{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/xi-kari.v3.ontology-read-trace-input.schema.json",
  "title": "Xi-Kari v3 model ontology read trace input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "records"],
  "properties": {
    "schema_id": {"const": "xi-kari.v3.ontology-read-trace-input"},
    "schema_version": {"const": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/modelRecord"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "modelRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "read_status", "content_witness", "content_excerpt",
        "problem_relation"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "read_status": {"const": "read"},
        "content_witness": {"$ref": "#/$defs/sha256"},
        "content_excerpt": {"type": "string", "minLength": 12},
        "problem_relation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "rationale"],
          "properties": {
            "status": {"enum": ["applied", "boundary_only", "not_applicable"]},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
