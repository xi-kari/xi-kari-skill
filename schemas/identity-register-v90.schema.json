{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-kari.local/schemas/identity-register-v90.schema.json",
  "title": "Xi-Kari v9.0 source identity register",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "framework_version",
    "source_raw_sha256",
    "identity_count",
    "identity_count_semantics",
    "identities"
  ],
  "properties": {
    "schema_id": {
      "enum": [
        "xi-kari.v9.0.identity-register",
        "xi-kari.v9.0.extended-identity-register"
      ]
    },
    "schema_version": {"const": 1},
    "framework_version": {"const": "v9.0"},
    "source_raw_sha256": {
      "const": "ffc45afdc288ecd268fd02e46d47318b7ddf17bf7b47605aa6c413c95398544b"
    },
    "identity_count": {"type": "integer", "minimum": 0},
    "identity_count_semantics": {"type": "string", "minLength": 1},
    "identities": {
      "type": "array",
      "items": {"$ref": "#/$defs/identity"}
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "concept_id",
        "source_concept_id",
        "identity_disposition",
        "semantic_family",
        "contract_role_interpretation",
        "primary_candidate_id",
        "candidate_ids",
        "card_path",
        "source_layer",
        "interpretation_layer",
        "source_undefined",
        "source_interface_fields",
        "conditional_support_routes",
        "branch_source_conditions",
        "legacy_identity_decision"
      ],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^V90-CANON-[A-Z0-9-]+$"},
        "source_concept_id": {"type": "string", "minLength": 1},
        "identity_disposition": {"type": "string", "minLength": 1},
        "semantic_family": {"type": "string", "minLength": 1},
        "contract_role_interpretation": {"type": "string", "minLength": 1},
        "primary_candidate_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^V90-CANDIDATE-"}
          ]
        },
        "definition_source_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V90-P\\d{5}$"}
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^V90-CANDIDATE-"}
        },
        "card_path": {
          "type": "string",
          "pattern": "^references/ontology/v9\\.0/cards/[a-z0-9-]+\\.md$"
        },
        "source_layer": {
          "type": "object",
          "required": [
            "authority_sha256",
            "source_refs",
            "source_anchors",
            "source_text_sha256"
          ],
          "properties": {
            "authority_sha256": {"const": "ffc45afdc288ecd268fd02e46d47318b7ddf17bf7b47605aa6c413c95398544b"},
            "source_refs": {"type": "array", "minItems": 1},
            "source_anchors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^V90-P\\d{5}$"}
            },
            "source_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "interpretation_layer": {
          "type": "object",
          "required": [
            "positive_boundary",
            "negative_boundary",
            "dependency_edges",
            "branch_dependency_additions",
            "dependency_completeness",
            "definition_dependency_boundary",
            "acceptance"
          ],
          "properties": {
            "positive_boundary": {"type": "string", "minLength": 1},
            "negative_boundary": {"type": "string", "minLength": 1},
            "dependency_edges": {"type": "array"},
            "branch_dependency_additions": {"type": "object"},
            "dependency_completeness": {"type": "string", "minLength": 1},
            "definition_dependency_boundary": {"type": "object"},
            "acceptance": {"type": "object"}
          }
        },
        "source_undefined": {"type": "array", "items": {"type": "string"}},
        "source_interface_fields": {"type": "array"},
        "conditional_support_routes": {"type": "array"},
        "branch_source_conditions": {"type": "array"},
        "legacy_identity_decision": {"type": "object"}
      }
    }
  }
}
